/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  # Deliberately scoped to the four directives that cannot break this site:
  # there is no <object>, <embed>, or <base> anywhere, and the only form action
  # is same-origin (/thanks). Note what is ABSENT: no default-src and no
  # script-src, so the Google Analytics snippet on 14 of 15 pages is untouched.
  # Locking scripts down needs GA's full endpoint set verified first (the
  # in-app browser blocks trackers, so it could not be observed here) and a
  # nonce or hash for the inline gtag block. Until then a script-src would risk
  # silently killing analytics, which is worse than not having one.
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Netlify serves .webmanifest as application/octet-stream, and because the site
# also sends X-Content-Type-Options: nosniff the browser refuses to sniff past
# that and drops the manifest entirely (no install icon, no Android theme
# color). The explicit Content-Type is what makes the manifest load at all.
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

# Icons are referenced by fixed filename, so they get a week rather than the
# immutable year used for content-hashed art.
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-32.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/android-chrome-192x192.png
  Cache-Control: public, max-age=604800
/android-chrome-512x512.png
  Cache-Control: public, max-age=604800

/art/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# "immutable" promises the bytes at this URL never change, so these filenames
# are only safe to cache this hard because every <link> to them carries a ?v=N
# cache key. BUMP THAT ?v= IN EVERY HTML FILE WHENEVER A TOKEN FILE CHANGES.
# Skipping the bump does not look like a bug, it looks like the edit did
# nothing: returning visitors keep the previous CSS for up to a year while a
# fresh browser shows the change. That is exactly how the TTF-to-WOFF2 switch
# appeared to fail, with correct CSS deployed and stale CSS being served.
# module-shell.css avoids this trap a second way, with max-age=0 +
# must-revalidate, which is why edits to it land immediately.
/tokens/*
  Cache-Control: public, max-age=31536000, immutable

/module-shell.css
  Cache-Control: public, max-age=0, must-revalidate

/module-shell.js
  Cache-Control: public, max-age=0, must-revalidate
